    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.18",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.24",
    "@swc/register": "^0.1.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
