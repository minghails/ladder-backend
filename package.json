    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/terminus": "^11.1.1",
    "drizzle-orm": "^0.45.2",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.3.0",
    "pino-http": "^11.0.0",
