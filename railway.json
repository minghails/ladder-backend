{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile",
    "watchPatterns": [
      "src/**",
      "docker/Dockerfile",
      "package.json",
      "pnpm-lock.yaml",
      "tsconfig*.json",
      "nest-cli.json",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": null,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
